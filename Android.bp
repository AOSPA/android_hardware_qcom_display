soong_config_module_type {
    name: "qtidisplay_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "qtidisplay",
    bool_variables: [
        "board_auto", // TARGET_BOARD_AUTO
        "enable_hyp", // ENABLE_HYP
        "is_headless", // TARGET_IS_HEADLESS
        "uses_fod_zpos", // TARGET_USES_FOD_ZPOS
        "uses_drm_pp", // TARGET_USES_DRM_PP
        "uses_gralloc4", // TARGET_USES_GRALLOC4
        "uses_ycrcb_camera_encode", // TARGET_USES_YCRCB_CAMERA_ENCODE
        "uses_ycrcb_camera_preview", // TARGET_USES_YCRCB_CAMERA_PREVIEW
        "needs_raw10_buffer_fix", // TARGET_NEEDS_RAW10_BUFFER_FIX
        "gralloc_handle_has_reserved_size", // TARGET_GRALLOC_HANDLE_HAS_RESERVED_SIZE
    ],
    properties: [
        "cflags",
        "cppflags",
    ],
}

qtidisplay_cc_defaults {
    name: "qtidisplay_defaults",
    cflags: [
        "-Wno-missing-field-initializers",
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
    ],
    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],
    soong_config_variables: {
        board_auto: {
            cflags: ["-DCONFIG_BASEID_FROM_PROP"],
        },
        enable_hyp: {
            cflags: ["-DHYPERVISOR"],
        },
        is_headless: {
            cflags: ["-DTARGET_HEADLESS"],
        },
        uses_fod_zpos: {
            cflags: ["-DFOD_ZPOS"],
        },
        uses_drm_pp: {
            cflags: ["-DPP_DRM_ENABLE"],
        },
        uses_gralloc4: {
            cflags: ["-DTARGET_USES_GRALLOC4"],
        },
        uses_ycrcb_camera_encode: {
            cflags: ["-DUSE_YCRCB_CAMERA_ENCODE"],
        },
        uses_ycrcb_camera_preview: {
            cflags: ["-DUSE_YCRCB_CAMERA_PREVIEW"],
        },
        needs_raw10_buffer_fix: {
            cflags: ["-DRAW10_BUFFER_FIX",],
        },
        gralloc_handle_has_reserved_size: {
            cflags: ["-DGRALLOC_HANDLE_HAS_RESERVED_SIZE"],
        },
    },
}

cc_library_headers {
    name: "display_headers",
    vendor: true,
    export_include_dirs: [
        "include",
        "libcopybit",
        "libdrmutils",
        "libqdutils",
        "libqservice",
        "gpu_tonemapper",
        "sdm/include",
        "gralloc",
        "libdebug",
    ],
    header_libs: ["libhardware_headers", "display_intf_headers"],
    export_header_lib_headers: ["libhardware_headers", "display_intf_headers"],
}
